{
  "name": "@agent-interaction-kit/core",
  "version": "0.1.0",
  "description": "Tool and interaction contract testing for AG-UI applications",
  "license": "MIT",
  "author": "João Victor Lopes (https://github.com/DevJoaoLopes)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevJoaoLopes/agent-interaction-kit.git"
  },
  "bugs": {
    "url": "https://github.com/DevJoaoLopes/agent-interaction-kit/issues"
  },
  "homepage": "https://github.com/DevJoaoLopes/agent-interaction-kit#readme",
  "keywords": [
    "agent",
    "contract-testing",
    "consumer-driven-contracts",
    "ag-ui",
    "copilotkit",
    "mastra",
    "testing",
    "ai-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "aik": "./dist/bin/aik.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./contracts": {
      "import": "./dist/contracts/index.js",
      "types": "./dist/contracts/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./reporters": {
      "import": "./dist/reporters/index.js",
      "types": "./dist/reporters/index.d.ts"
    }
  },
  "files": ["dist", "bin"],
  "scripts": {
    "aik": "node dist/bin/aik.js",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
