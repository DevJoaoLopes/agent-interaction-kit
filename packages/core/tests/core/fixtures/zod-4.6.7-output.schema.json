{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "city": {
      "type": "string"
    },
    "units": {
      "default": "c",
      "type": "string",
      "enum": ["c", "f"]
    },
    "note": {
      "type": ["string", "null"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "const": "ok"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": ["city", "units", "note", "status", "count"],
  "additionalProperties": false
}
