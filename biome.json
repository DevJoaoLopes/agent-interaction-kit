{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "**/dist/**",
      "**/node_modules/**",
      "**/.astro/**",
      "**/test-results/**",
      "**/playwright-report/**",
      "examples/maf-dotnet/**/bin/**",
      "examples/maf-dotnet/**/obj/**",
      "examples/maf-dotnet/fixtures/tools.json",
      "apps/website/src/styles/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
