{
  "name": "agent-interaction-kit-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm build:core && pnpm --filter @agent-interaction-kit/website dev",
    "build": "pnpm build:core && pnpm build:web",
    "build:core": "pnpm --filter @agent-interaction-kit/core build",
    "build:web": "pnpm --filter @agent-interaction-kit/website build",
    "test": "pnpm --filter @agent-interaction-kit/core test",
    "test:web": "pnpm --filter @agent-interaction-kit/website test",
    "typecheck": "pnpm --filter @agent-interaction-kit/core typecheck && pnpm --filter @agent-interaction-kit/website typecheck",
    "check": "biome check . && pnpm --filter @agent-interaction-kit/website format:check",
    "format": "biome check --write . && pnpm --filter @agent-interaction-kit/website format",
    "knip": "knip",
    "knip:production": "knip --production"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "knip": "^6.34.0"
  }
}
