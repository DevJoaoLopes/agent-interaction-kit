{
  "$schema": "https://aik.dev/schemas/v1/provider.json",
  "schemaVersion": "1.0.0",
  "producer": {
    "name": "enterprise-agent-backend",
    "version": "1.0.0",
    "buildId": "git-b101"
  },
  "protocolProfile": "ag-ui@0.1",
  "contextProfile": "default",
  "tools": [
    {
      "name": "searchDocuments",
      "executionSide": "backend",
      "description": "Searches internal documents",
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "limit": { "type": "number" }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "returns": {
        "format": "json",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            },
            "required": ["id", "title"]
          }
        }
      },
      "requiresApproval": false
    }
  ]
}
